# ── IA do chat da landing (/api/ai-chat) ──
# Cadeia de fallback: Gemini → Groq. Só entra na cadeia quem tiver chave.
# Sem nenhuma chave, a rota cai num placeholder em streaming.

# Gemini (primário) — grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (fallback, opcional) — grátis em https://console.groq.com/keys
GROQ_API_KEY=

# ── Tracker de visitas → Discord (/api/track) ──
# Segredo de servidor: NÃO use prefixo NEXT_PUBLIC_. Sem isso, o tracker é no-op.
# Crie em: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=
