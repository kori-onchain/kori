{
  "expo": {
    "name": "Kori",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "kori",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kori.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita o uso do Face ID para acessar o aplicativo de forma segura."
        }
      ]
    ],
    "extra": {
      "privyAppId": "cmpr1els201hw0dl4wbg6ckqw",
      "privyClientId": "client-WY6ZaaiWzRZk9PwWwDtjpGyvhSn8WLKqa1qJ4m4RQzYc8",
      "apiUrl": "http://192.168.0.100:3333",
      "eas": {
        "projectId": "eea0cd1c-0dd3-4f65-98d3-1f0ecfe20676"
      }
    },
    "owner": "kc1t"
  }
}
