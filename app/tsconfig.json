{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-native",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@screens/*": [
        "./src/screens/*"
      ],
      "@theme/*": [
        "./src/theme/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@type/*": [
        "./src/types/*"
      ],
      "@constants/*": [
        "./src/constants/*"
      ]
    }
  }
}